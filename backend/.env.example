# IOCtopus backend security settings. All optional - defaults are safe for
# localhost-only use. Set them as environment variables before starting uvicorn
# (PowerShell: $env:IOCTOPUS_API_KEY = "..."). uvicorn does not read this file.

# Browser origins allowed to call the API (comma-separated)
IOCTOPUS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host header allowlist (DNS-rebinding protection). Add the LAN IP if you bind to it.
IOCTOPUS_ALLOWED_HOSTS=localhost,127.0.0.1

# Require X-API-Key on analysis endpoints. Empty = disabled.
IOCTOPUS_API_KEY=

IOCTOPUS_MAX_UPLOAD_MB=50
IOCTOPUS_RATE_LIMIT_PER_MINUTE=30
IOCTOPUS_MAX_CONCURRENT=2
IOCTOPUS_QUEUE_TIMEOUT=30

# Interactive API docs at /docs (off by default)
IOCTOPUS_ENABLE_DOCS=false
