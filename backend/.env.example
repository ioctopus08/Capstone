# Gozetci backend security settings. All optional - defaults are safe for
# localhost-only use. Set them as environment variables before starting uvicorn
# (PowerShell: $env:GOZETCI_API_KEY = "..."). uvicorn does not read this file.

# Browser origins allowed to call the API (comma-separated)
GOZETCI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host header allowlist (DNS-rebinding protection). Add the LAN IP if you bind to it.
GOZETCI_ALLOWED_HOSTS=localhost,127.0.0.1

# Require X-API-Key on analysis endpoints. Empty = disabled.
GOZETCI_API_KEY=

GOZETCI_MAX_UPLOAD_MB=50
GOZETCI_RATE_LIMIT_PER_MINUTE=30
GOZETCI_MAX_CONCURRENT=2
GOZETCI_QUEUE_TIMEOUT=30

# Interactive API docs at /docs (off by default)
GOZETCI_ENABLE_DOCS=false
